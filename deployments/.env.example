# =====================================================================
#  24Alert Trading Bot — Environment Variables (example)
# =====================================================================
#  Скопируйте этот файл в .env и подставьте реальные токены:
#    cp .env.example .env
# =====================================================================

# Режим: true = sandbox, false = production
TINVEST_SANDBOX=true

# Токен для песочницы
TINVEST_SANDBOX_TOKEN=t.YOUR_SANDBOX_TOKEN_HERE

# Токен для боевого контура
TINVEST_PROD_TOKEN=t.YOUR_PROD_TOKEN_HERE

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info
