# =====================================================================
#  24Alert Trading Bot — Environment Variables (example)
# =====================================================================
#  Скопируйте этот файл в .env и подставьте реальные токены:
#    cp .env.example .env
# =====================================================================

# Режим: true = sandbox, false = production
TINVEST_SANDBOX=true

# Токен для песочницы
TINVEST_SANDBOX_TOKEN=t.YOUR_SANDBOX_TOKEN_HERE

# Токен для боевого контура
TINVEST_PROD_TOKEN=t.YOUR_PROD_TOKEN_HERE

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info

# =====================================================================
#  AI Scanner (автономный Cursor Agent)
# =====================================================================

# Cursor API Key — генерируется на https://cursor.com/dashboard/integrations
# Используется для автономного AI Scanner (cron-задачи: post-market, pre-market, health)
CURSOR_API_KEY=crsr_YOUR_KEY_HERE

# Модель для автономного AI Scanner (Cursor Agent CLI)
# Доступные: composer-2, claude-4-sonnet-thinking, gpt-5.2
AI_SCANNER_MODEL=composer-2

# =====================================================================
#  AI Chat (интерактивный чат в дашборде)
# =====================================================================

# OpenRouter API Key — генерируется на https://openrouter.ai/keys
# Используется для интерактивного чат-ассистента в дашборде стратегий
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Модель для интерактивного чата (OpenRouter формат)
# Примеры: anthropic/claude-sonnet-4, openai/gpt-4.1, google/gemini-2.5-flash
AI_CHAT_MODEL=anthropic/claude-sonnet-4

# AI Trader (выводы каждые ~15 с) — отдельно от чата
# По умолчанию: google/gemma-4-31b-it:free (лимиты OpenRouter: ~50 req/день без credits)
# Альтернативы free: nvidia/nemotron-3-super-120b-a12b:free, openai/gpt-oss-120b:free
# Платные: deepseek/deepseek-v4-flash
AI_TRADER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_TRADER_MODEL_FALLBACKS=google/gemma-4-31b-it:free
AI_TRADER_LLM_INTERVAL_SEC=90

# Paper engine: запись тиков для replay, streaming book, комиссия
AI_TRADER_RECORD_ENABLED=true
AI_TRADER_STREAM_BOOK=false
AI_TRADER_PAPER_COMMISSION_BPS=4
AI_TRADER_PAPER_SLIPPAGE_BPS=1

# =====================================================================
#  advisor-svc (иерархические отчёты AI Trader)
# =====================================================================
ADVISOR_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ADVISOR_MODEL_FALLBACKS=google/gemma-4-31b-it:free
# Последний резерв после free-моделей и повторов
ADVISOR_PAID_MODEL=google/gemini-2.5-flash
ADVISOR_LLM_RETRIES=2
ADVISOR_LLM_MAX_TOKENS=4096
ADVISOR_FACTS_FALLBACK=true
