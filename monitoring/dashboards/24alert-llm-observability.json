{
  "title": "24alert LLM / OpenRouter",
  "uid": "24alert-llm",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "Europe/Moscow",
  "editable": true,
  "tags": ["24alert", "llm", "openrouter"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(alert24_llm_requests_total, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(alert24_llm_requests_total{service=~\"$service\"}, model)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "LLM requests (by model tag)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Request rate by service + result",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service, result) (rate(alert24_llm_requests_total{service=~\"$service\", model=~\"$model\"}[5m]))",
          "legendFormat": "{{ service }} / {{ result }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "timeseries",
      "title": "Request rate by model (success only)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (rate(alert24_llm_requests_total{service=~\"$service\", model=~\"$model\", result=\"success\"}[5m]))",
          "legendFormat": "{{ model }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Errors / rate-limit / parse (non-success)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model, result) (rate(alert24_llm_requests_total{service=~\"$service\", model=~\"$model\", result!=\"success\"}[5m]))",
          "legendFormat": "{{ model }} / {{ result }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (successful calls)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service, model) (rate(alert24_llm_request_duration_seconds_bucket{service=~\"$service\", model=~\"$model\"}[5m])))",
          "legendFormat": "p95 {{ service }} / {{ model }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "Total LLM calls (6h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(alert24_llm_requests_total{service=~\"$service\", model=~\"$model\"}[6h]))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Success (6h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(alert24_llm_requests_total{service=~\"$service\", model=~\"$model\", result=\"success\"}[6h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Fallback (6h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(alert24_llm_requests_total{service=~\"$service\", result=\"fallback\"}[6h]))",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Rate limit (6h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(alert24_llm_requests_total{service=~\"$service\", model=~\"$model\", result=\"rate_limit\"}[6h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Advisor-svc reports",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Advisor reports by timeframe + status",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (timeframe, status) (rate(advisor_reports_total[5m]))",
          "legendFormat": "{{ timeframe }} {{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Advisor LLM errors (legacy metric, by model)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (rate(advisor_llm_errors_total[5m]))",
          "legendFormat": "{{ model }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs (model in log line)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false
    },
    {
      "type": "logs",
      "title": "AI Trader LLM",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"strategy-runner\"} |~ \"ai trader llm|advisor llm\"",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Advisor-svc",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=~\"advisor-svc|24alert-advisor-svc\"} |~ \"advisor llm\"",
          "refId": "A"
        }
      ]
    }
  ]
}
