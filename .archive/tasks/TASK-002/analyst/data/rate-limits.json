  "backoff_strategy": {
    "error_code": "ResourceExhausted",
    "grpc_status_code": 8,
    "sdk_behavior": "Automatic exponential backoff with max retries (configurable)",
    "recommended_client_strategy": [
      "1. Use SDK's built-in retry mechanism (DisableResourceExhaustedRetry=false)",
      "2. Implement per-method rate limiters (token bucket pattern)",
      "3. Monitor x-ratelimit-remaining headers in responses",
      "4. Implement circuit breaker for cascading failures"
    ]
  },
  "best_practices": [
    "Use token bucket rate limiters per method to stay within limits",
    "Multiplex MarketDataStream subscriptions to avoid connection limit exhaustion",
    "Use postOrderAsync for high-frequency strategies (600/min vs 15/sec for sync)",
    "Cache instrument metadata to reduce API calls",
    "Use streaming APIs instead of polling when possible",
    "Implement correlation IDs for request tracing",
    "Monitor rate limit headers and adjust request rate dynamically",
    "Never send more than 50 requests per second total (hard global limit)"
